# ExposureIQ backend configuration. Copy to .env (git-ignored) and fill in what you have.
# With no credentials at all, ExposureIQ runs on its built-in mock tenant.
# As soon as any source below has credentials, it switches to live mode and only syncs configured sources.

# ---------- AI agents (Google Gemini) ----------
# Without a key the four agents run on the deterministic rules engine.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Budget: agent runs per minute (each run is 3-5 model calls). One is always kept for people (copilot, "Run now").
# Background work beyond the budget, and low-priority (P3/P4) triage, uses the rules engine.
AGENT_MAX_RUNS_PER_MIN=3
# Backup model(s), used when the main one is rate-limited or overloaded (quotas are per model)
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite
# Calls per minute per model. The free tier allows 5 on the Flash models; raise it if you enable billing.
GEMINI_MAX_CALLS_PER_MIN=5
AGENT_MAX_STEPS=10

# ---------- Data mode ----------
# auto (default): mock until credentials exist · mock: always the mock tenant · live: real connectors only
DATA_MODE=auto
# Mock mode only: milliseconds between simulated syncs
DEMO_TICK_MS=6000

# ---------- Microsoft Defender for Endpoint / Defender Vulnerability Management ----------
# Entra ID app registration → API permissions → "WindowsDefenderATP" (application):
#   Machine.Read.All, Vulnerability.Read.All   (grant admin consent)
DEFENDER_TENANT_ID=
DEFENDER_CLIENT_ID=
DEFENDER_CLIENT_SECRET=
# Regional hosts also work, e.g. https://api-eu.securitycenter.microsoft.com
DEFENDER_API_BASE=https://api.security.microsoft.com
DEFENDER_SCOPE=https://api.securitycenter.microsoft.com/.default
DEFENDER_SYNC_MINUTES=30

# ---------- Rapid7 InsightVM (security console API v3) ----------
# A console user with read access to the sites in scope. Self-signed console certificate?
# Point NODE_EXTRA_CA_CERTS at the console's CA certificate (PEM) when starting the backend.
RAPID7_CONSOLE_URL=
RAPID7_USERNAME=
RAPID7_PASSWORD=
# Optional: limit to these site ids (comma-separated). Empty = every site the user can see.
RAPID7_SITE_IDS=
# Include unconfirmed ("potential") results
RAPID7_INCLUDE_POTENTIAL=false
# How often each site is re-read
RAPID7_SYNC_MINUTES=60

# ---------- ServiceNow (CMDB context + tickets) ----------
# User needs read on the CMDB table and create on the ticket table.
SERVICENOW_INSTANCE=
SERVICENOW_USERNAME=
SERVICENOW_PASSWORD=
SERVICENOW_CMDB_TABLE=cmdb_ci_computer
SERVICENOW_TICKET_TABLE=incident
# Field names in your CMDB for criticality tier, business service and internet exposure
SERVICENOW_TIER_FIELD=u_criticality_tier
SERVICENOW_SERVICE_FIELD=u_business_service
SERVICENOW_INTERNET_FIELD=u_internet_facing
CMDB_SYNC_MINUTES=720

# ---------- Threat intelligence (public, no credentials) ----------
KEV_FEED_URL=https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json
EPSS_API_URL=https://api.first.org/data/v1/epss
INTEL_SYNC_MINUTES=720

# ---------- SOC notifications (optional) ----------
# Any incoming webhook that accepts {"text": "..."} (Microsoft Teams, Slack). Empty = logged only.
SOC_WEBHOOK_URL=

PORT=4100
